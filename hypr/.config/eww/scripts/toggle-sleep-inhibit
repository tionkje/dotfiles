#!/usr/bin/env bash
set -euo pipefail
trap 'notify-send -u critical "Error: $(basename "$0")" "Line $LINENO failed (exit $?)"' ERR

PID_FILE="${XDG_RUNTIME_DIR:-/tmp}/eww-sleep-inhibit.pid"
STATE_CSS="$HOME/.config/waybar/sleep-inhibit-state.css"

update_waybar() {
    if [ "$1" = on ]; then
        echo 'window#waybar { background: #ff7800; }' > "$STATE_CSS"
    else
        : > "$STATE_CSS"
    fi
    # SIGUSR2 makes waybar reload its config and css. waybar may not be
    # running (pkill exits 1); the state file is then picked up on next start.
    pkill -SIGUSR2 -x waybar || true
}

is_inhibited() {
    [ -f "$PID_FILE" ] || return 1
    local pid
    pid=$(cat "$PID_FILE")
    [ -d "/proc/$pid" ] || return 1
    grep -q '^systemd-inhibit$' "/proc/$pid/comm"
}

if is_inhibited; then
    pid=$(cat "$PID_FILE")
    rm -f "$PID_FILE"
    kill "$pid"
    update_waybar off
    notify-send "Sleep inhibit off" "System may sleep again"
else
    rm -f "$PID_FILE"
    # detach from eww's pipes so the inhibit holder survives this script's exit.
    # stderr goes to the journal under tag eww-sleep-inhibit so errors are still discoverable.
    setsid systemd-cat -t eww-sleep-inhibit \
        systemd-inhibit \
            --what=idle:sleep \
            --who=eww \
            --why="Manual sleep inhibit" \
            --mode=block \
            sleep infinity </dev/null &
    echo $! > "$PID_FILE"
    disown
    update_waybar on
    notify-send "Sleep inhibit on" "System will stay awake"
fi
