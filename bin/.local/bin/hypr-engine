#!/usr/bin/env bash
source "$HOME/.local/bin/err-notify"
set -euo pipefail

DOTFILES=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../.." && pwd)

# The engine (lua vs hyprlang) is only re-evaluated at startup or on a
# full-reset reload; a plain `hyprctl reload` (and autoreload) re-parses the
# current engine's config and silently keeps the old provider.
apply_live() {
  local live dir sig
  # Probe instead of trusting HYPRLAND_INSTANCE_SIGNATURE: after a compositor
  # crash the env var in existing shells points at a dead socket (install.sh
  # also runs this from a TTY with no instance at all). Fall back to scanning
  # the runtime dir for a socket that answers.
  if ! live=$(hyprctl status 2>&1); then
    for dir in "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hypr"/*/; do
      [[ -S $dir.socket.sock ]] || continue
      sig=$(basename "$dir")
      if live=$(HYPRLAND_INSTANCE_SIGNATURE=$sig hyprctl status 2>&1); then
        export HYPRLAND_INSTANCE_SIGNATURE=$sig
        break
      fi
    done
  fi
  if [[ $live != *configProvider:* ]]; then
    echo "hypr-engine: no reachable Hyprland instance ($live); engine applies on next start" >&2
    return 0
  fi
  local provider=hyprlang
  [[ $live == *"configProvider: lua"* ]] && provider=lua
  local want=hyprlang
  [[ $1 == lua ]] && want=lua
  # Provider already matches: plain reload re-parses the config without the
  # provider rebuild, which is all that's needed.
  if [[ $provider == "$want" ]]; then
    hyprctl reload
    return 0
  fi
  # ponytail: upstream Hyprland 0.56.0 bug — `reload full-reset` while the lua
  # provider is active SEGVs/aborts in CConfigValueBase::flushCaches(). Drop
  # this guard once fixed upstream.
  if [[ $provider == lua ]]; then
    echo "hypr-engine: live lua->conf switch segfaults Hyprland 0.56.0; restart Hyprland to apply" >&2
    return 0
  fi
  hyprctl reload full-reset
}

case ${1:-} in
  lua)
    # Hyprland prefers hyprland.lua over hyprland.conf at startup (verified in
    # Hyprland's ConfigManager: it checks .lua first, falls back to .conf), so
    # activating lua just adds the .lua overlay. Ensure the .conf fallback with
    # a non-destructive stow (no -D → no unlink window): deliberately never
    # unlink the running instance's active config, or Hyprland regenerates a
    # default stub live and breaks the session.
    stow --no-folding -d "$DOTFILES" -t "$HOME" hypr-conf
    stow --no-folding -d "$DOTFILES" -t "$HOME" hypr-lua
    apply_live lua
    ;;
  conf)
    # Ensure the fallback, then drop the .lua overlay so startup uses .conf.
    # rm -f, not stow -D: a running lua instance may have regenerated
    # hyprland.lua as a regular-file stub, which stow refuses to delete.
    stow --no-folding -d "$DOTFILES" -t "$HOME" hypr-conf
    rm -f "$HOME/.config/hypr/hyprland.lua"
    apply_live conf
    ;;
  status)
    [[ -L $HOME/.config/hypr/hyprland.lua  ]] && echo lua  && exit 0
    [[ -L $HOME/.config/hypr/hyprland.conf ]] && echo conf && exit 0
    echo none
    ;;
  *) echo "usage: hypr-engine lua|conf|status" >&2; exit 2 ;;
esac
