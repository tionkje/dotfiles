#!/usr/bin/env bash
# Run a shell command string; surface a non-zero exit as a critical
# notification instead of dying silently when spawned by Hyprland/eww/hypridle.
# Usage: err-run 'command string'
set -u

if (( $# != 1 )); then
  echo "err-run: expected exactly 1 argument (a shell command string), got $#: $*" >&2
  notify-send -u critical "err-run" "expected 1 argument, got $#: $*"
  exit 2
fi

bash -c "$1"
status=$?
if (( status != 0 )); then
  echo "err-run: exit $status: $1" >&2
  notify-send -u critical "error (exit $status)" "$1"
  exit "$status"
fi
