{
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh api:*)",
      "Bash(pnpm list:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm run:*)",
      "Bash(pnpm turbo run:*)",
      "mcp__playwright",
      "WebSearch"
    ],
    "deny": [
      "Read(**/theoretical_ballast/*)",
      "Read(*/.env.local*)",
      "Read(*/personal/*)",
      "WebFetch(domain:telemetry.vercel.com)",
      "Bash(pnpm cat:*)"
    ],
    "ask": [
      "mcp__claude_ai_Atlassian__*"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-fable-5[1m]",
  "statusLine": {
    "type": "command",
    "command": "/home/bastiaan/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipAutoPermissionPrompt": true,
  "autoMemoryEnabled": false
}
