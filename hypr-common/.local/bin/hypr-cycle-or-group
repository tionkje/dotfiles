#!/bin/bash
source "$HOME/.local/bin/err-notify"
set -euo pipefail

# Direction: f (forward) or b (backward). Default forward.
dir="${1:-f}"
case "$dir" in
  f) cycle="next"; group_dir="f" ;;
  b) cycle="prev"; group_dir="b" ;;
  *) echo "[hypr-cycle-or-group] usage: $0 [f|b]" >&2; exit 2 ;;
esac

before=$(hyprctl activewindow -j | jq -r '.address // empty')
hypr-dispatch cyclenext "$cycle" >/dev/null
after=$(hyprctl activewindow -j | jq -r '.address // empty')

if [[ "$before" == "$after" ]]; then
  hypr-dispatch changegroupactive "$group_dir" >/dev/null
fi
